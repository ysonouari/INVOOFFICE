# Supabase — Configuration
# Copier ce fichier en .env et remplacer les valeurs

# URL du projet Supabase (publique)
SUPABASE_URL=https://xxxxx.supabase.co

# Clé anon (publique — utilisée côté client)
SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ SECRET — Ne jamais utiliser dans le navigateur
# Utilisée uniquement par les scripts d'administration (supabase/scripts/)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ⚠️ SECRET — Access token pour le CLI Supabase
SUPABASE_ACCESS_TOKEN=sbp_...

# Compte administrateur initial (créé via seed)
ADMIN_EMAIL=admin@invooffice.com
ADMIN_PASSWORD=votre_mot_de_passe_securise
